# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<username>:<password>@campuslink.evdsru5.mongodb.net/campuslink?retryWrites=true&w=majority
DB_NAME=campuslink

# Runtime environment
APP_ENV=development
ALLOW_LAN_ORIGINS=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REQUIRE_REDIS_IN_PRODUCTION=true
REQUIRE_TURN_IN_PRODUCTION=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=5000

# JWT secret for access tokens
JWT_SECRET=your-strong-jwt-secret

# Admin account credentials (optional for local/dev)
ADMIN_EMAIL=admin@campuslink.com
ADMIN_PASSWORD=CampusLink@2024

# Resend email service
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=noreply@yourdomain.com

# AI / Emergent integration
EMERGENT_LLM_KEY=your-emergent-llm-key

# Shared state for horizontal scaling
# REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=campuslink

# Optional RTC relay configuration for production WebRTC reliability
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-password
